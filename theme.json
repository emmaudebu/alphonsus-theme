{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1100px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "navy", "name": "Navy", "color": "#1a2180" },
				{ "slug": "ink", "name": "Ink", "color": "#131735" },
				{ "slug": "brown", "name": "Brown", "color": "#8a3a14" },
				{ "slug": "orange", "name": "Orange", "color": "#ffa53d" },
				{ "slug": "green", "name": "Green", "color": "#2d7a4c" },
				{ "slug": "cream", "name": "Cream", "color": "#f6f4ef" },
				{ "slug": "blue-soft", "name": "Soft blue", "color": "#eef1fa" },
				{ "slug": "lilac", "name": "Lilac", "color": "#e4e6f4" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "muted", "name": "Muted text", "color": "#5e6279" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "serif", "name": "Source Serif 4", "fontFamily": "\"Source Serif 4\", Georgia, serif" },
				{ "slug": "sans", "name": "DM Sans", "fontFamily": "\"DM Sans\", system-ui, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "14px" },
				{ "slug": "medium", "name": "Medium", "size": "17px" },
				{ "slug": "large", "name": "Large", "size": "22px" },
				{ "slug": "x-large", "name": "Extra large", "size": "32px" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%" ]
		}
	}
}
